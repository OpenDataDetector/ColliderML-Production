# Container images of the docker/podman pipeline. This file is the single place
# the image names are set; run_pipeline_docker.sh and run_docker.sh read it.
# Override per run with --sim-image / --reco-image or the environment variables.

# Generation, Geant4, ACTS digitisation and tracking, truth tables, packaging.
SIM_IMAGE="${SIM_IMAGE:-ghcr.io/opendatadetector/sw:pr-8}"

# Calorimeter digitisation, Pandora particle flow and the calo/PFO tables.
RECO_IMAGE="${RECO_IMAGE:-localhost/colliderml/reco:20261106}"
