# Container images of the docker/podman pipeline. This file is the single place
# the image names are set; run_pipeline_docker.sh and run_docker.sh read it.
# Override per run with --sim-image / --reco-image or the environment variables.

# Generation, Geant4, ACTS digitisation and tracking, truth tables, packaging.
# Vertex-to-track links (the track_ids, track_weights, truth_interaction and
# truth_interaction_dz columns of reco/vertices) need a sim image that also has
# the colliderml_vertex_links module: build it from image/vertex_track_links/
# and pass it with --sim-image. With this image the chain runs without them.
SIM_IMAGE="${SIM_IMAGE:-ghcr.io/opendatadetector/sw:pr-8}"

# Calorimeter digitisation, Pandora particle flow and the calo/PFO tables.
# Recipe: image/colliderml-reco/. The tag 20261127 is never moved; the digest is
# sha256:8ff91c13f21353ff04ee6924427a61dd3df523afa06b652072f7420efea24dd9.
RECO_IMAGE="${RECO_IMAGE:-ghcr.io/opendatadetector/colliderml-reco:20261127}"
